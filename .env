# MallT dev configuration. Committed on purpose (private repo, owner decision).
# Production values live in AWS SSM / Secrets Manager, never here.
ENV=dev

# --- Database: Neon project "mallt-dev" (Singapore, Postgres 17), pooled connection ---
DATABASE_URL=postgresql://neondb_owner:npg_FoS4aevO6uZd@ep-holy-frost-aowqt96e-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# --- Redis is OPTIONAL. Leave empty to use the Postgres-backed KV and inline jobs. ---
REDIS_URL=

# --- Auth ---
JWT_SECRET=1e3438e60c68eb7c91149c26c89fbea206d89055e2edbf2d4b61cf55a67ae503
OTP_PEPPER=401f02609e20d2a6c87b9649f3a6754e3efca92853218f70c6bf0cd1f5f2f493
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# --- SMS: console prints the OTP in dev; switch to fast2sms to really send ---
SMS_BACKEND=console
FAST2SMS_API_KEY=xsQLJrKrV6KgXOYBWPHNzCCESeEAkJWPX8lSBhuKMEZ8i1dK8TBPdSDb2U0N

# --- Google sign-in (create an OAuth client in Google Cloud, then fill both) ---
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Object storage: Neon Object Storage bucket "mallt-dev" (S3 API) ---
S3_ENDPOINT_URL=https://br-fancy-mode-aoal8yel.storage.c-2.ap-southeast-1.aws.neon.tech
S3_REGION=ap-southeast-1
S3_BUCKET=mallt-dev
S3_ACCESS_KEY_ID=nak_live_fcc3ceae6b0844a1adf280015f502805
S3_SECRET_ACCESS_KEY=nsk_live_27cc50134093206e35af0ba706dab11f11272157e20958513962f2ace8d41453
S3_PUBLIC_BASE_URL=https://br-fancy-mode-aoal8yel.storage.c-2.ap-southeast-1.aws.neon.tech/mallt-dev


# Payments: "fake" pays instantly (dev); "zoho" = Zoho Payments with Split (marketplace) payouts.
PAYMENTS_PROVIDER=fake
# Gateway fee each store bears on its own share, in basis points (50 = 0.50%).
GATEWAY_FEE_BPS=50
# Zoho Payments (India). Fill these from your Zoho Payments sandbox to try real payments locally.
# Account id: Zoho Payments > Settings. OAuth: an ORG client at api-console.zoho.in with an
# offline refresh token (scopes: ZohoPay(Sandbox).payments/refunds/transfers/connectedaccounts).
ZOHO_ACCOUNT_ID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# The checkout widget's API key (Settings > Developer Space).
ZOHO_API_KEY=
# Signing key Zoho shows when you create the webhook (POST /api/v1/payments/zoho/webhook).
ZOHO_WEBHOOK_SIGNING_KEY=
# true = paymentssandbox.zoho.in and widget test mode.
ZOHO_SANDBOX=true
# Hosted frontend without nginx (Vercel): the API origin to proxy /api to, and to open WebSockets on.
# Leave empty for docker compose / local dev.
API_PROXY_URL=
NEXT_PUBLIC_WS_BASE=
# Demo mode for the frontend: 1 serves built-in sample data from app/api/v1 instead of the API.
DEMO_API=

# ---- Customer notifications ----
# Links in push / WhatsApp messages point here (the customer site, no trailing slash).
PUBLIC_SITE_URL=http://localhost:8080
# Web Push for the installable app (dev pair; make your own with `python -m mallt.cli vapid-keys`).
# Leave both empty to switch push off. Push services are free.
VAPID_PRIVATE_KEY=EpP0iZsk-a5Emmwb8xkv77T7M5xSBiDEHicUZei3dUQ
VAPID_PUBLIC_KEY=BKnGr2fBD61OSTCTzdDPUiFrgaRz_L1as7k9IhLo-AixMvb0SpFvC_Mnm2x6I8SEvbzn0A1uLSMEEAt1HU-11JU
VAPID_SUBJECT=https://tabble-mall.vercel.app
# WhatsApp: off (default) | log (dev: logs instead of sending) | meta (WhatsApp Cloud API).
# Also needs the "whatsapp" switch on in the owner dashboard and each customer's opt-in.
WHATSAPP_PROVIDER=off
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=en
