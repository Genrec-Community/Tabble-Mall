# --- Auth ---
JWT_SECRET=1e3438e60c68eb7c91149c26c89fbea206d89055e2edbf2d4b61cf55a67ae503
OTP_PEPPER=401f02609e20d2a6c87b9649f3a6754e3efca92853218f70c6bf0cd1f5f2f493
COOKIE_SECURE=false
