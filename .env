# MallT dev configuration. Committed on purpose (private repo, owner decision).
# Production values live in AWS SSM / Secrets Manager, never here.
ENV=dev

# --- Database: Neon project "mallt-dev" (Singapore, Postgres 17), pooled connection ---
DATABASE_URL=postgresql://neondb_owner:npg_FoS4aevO6uZd@ep-holy-frost-aowqt96e-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# --- Redis is OPTIONAL. Leave empty to use the Postgres-backed KV and inline jobs. ---
