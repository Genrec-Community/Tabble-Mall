            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Ready",
        "tags": [
          "health"
        ]
      }
    }
  }
}
