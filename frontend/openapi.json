{
  "components": {
    "schemas": {
      "GrantOut": {
        "properties": {
          "mall_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mall Id"
          },
          "organization_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Organization Id"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "title": "Permissions",
            "type": "array"
          },
          "role_key": {
            "title": "Role Key",
            "type": "string"
          },
          "scope_type": {
            "$ref": "#/components/schemas/ScopeType"
          },
          "store_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Store Id"
          }
        },
        "required": [
          "role_key",
          "scope_type",
          "organization_id",
          "mall_id",
          "store_id",
          "permissions"
        ],
        "title": "GrantOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PasswordChange": {
        "properties": {
          "current_password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Current Password",
            "type": "string"
          },
          "new_password": {
            "maxLength": 256,
            "minLength": 10,
            "title": "New Password",
            "type": "string"
          }
        },
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "PasswordChange",
        "type": "object"
      },
      "ScopeType": {
        "enum": [
          "platform",
          "organization",
          "mall",
          "store"
        ],
        "title": "ScopeType",
        "type": "string"
      },
      "SessionOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "current": {
            "title": "Current",
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "ip": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ip"
          },
          "last_seen_at": {
            "format": "date-time",
            "title": "Last Seen At",
            "type": "string"
          },
          "user_agent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Agent"
          }
        },
        "required": [
          "id",
          "created_at",
          "last_seen_at",
          "user_agent",
          "ip",
          "current"
        ],
        "title": "SessionOut",
        "type": "object"
      },
      "StaffLogin": {
        "properties": {
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "totp_code": {
            "anyOf": [
              {
                "maxLength": 10,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Totp Code"
          },
          "username": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "StaffLogin",
        "type": "object"
      },
      "StaffMe": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "grants": {
            "items": {
              "$ref": "#/components/schemas/GrantOut"
            },
            "title": "Grants",
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "must_change_password": {
            "title": "Must Change Password",
            "type": "boolean"
          },
          "totp_enabled": {
            "title": "Totp Enabled",
            "type": "boolean"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "display_name",
          "must_change_password",
          "totp_enabled",
          "grants"
        ],
        "title": "StaffMe",
        "type": "object"
      },
      "StatusOut": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "StatusOut",
        "type": "object"
      },
      "TokenOut": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "token_type": {
            "const": "bearer",
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "expires_in"
        ],
        "title": "TokenOut",
        "type": "object"
      },
      "TotpConfirm": {
        "properties": {
          "code": {
            "maxLength": 10,
            "minLength": 6,
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "TotpConfirm",
        "type": "object"
      },
      "TotpSetupOut": {
        "properties": {
          "otpauth_uri": {
            "title": "Otpauth Uri",
            "type": "string"
          },
          "secret": {
            "title": "Secret",
            "type": "string"
          }
        },
        "required": [
          "secret",
          "otpauth_uri"
        ],
        "title": "TotpSetupOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "MallT API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/staff/login": {
      "post": {
        "operationId": "auth_staff_login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StaffLogin"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Staff Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/staff/logout": {
      "post": {
        "operationId": "auth_staff_logout",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Staff Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/staff/logout-all": {
      "post": {
        "operationId": "auth_staff_logout_all",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Staff Logout All",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/staff/me": {
      "get": {
        "operationId": "auth_staff_me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffMe"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Staff Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/staff/password": {
      "post": {
        "operationId": "auth_staff_change_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordChange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Staff Change Password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/staff/refresh": {
      "post": {
        "operationId": "auth_staff_refresh",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Staff Refresh",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/staff/sessions": {
      "get": {
        "operationId": "auth_staff_sessions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SessionOut"
                  },
                  "title": "Response Auth Staff Sessions",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Staff Sessions",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/staff/totp/confirm": {
      "post": {
        "operationId": "auth_staff_totp_confirm",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TotpConfirm"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Staff Totp Confirm",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/staff/totp/setup": {
      "post": {
        "operationId": "auth_staff_totp_setup",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TotpSetupOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Staff Totp Setup",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "health_get_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/ready": {
      "get": {
        "operationId": "health_get_ready",
        "responses": {
